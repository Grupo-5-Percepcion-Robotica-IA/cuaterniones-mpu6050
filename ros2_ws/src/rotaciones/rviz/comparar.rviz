Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10
      Color: 160; 160; 164
      Alpha: 0.5
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz_default_plugins/Axes
      Name: Origen (world)
      Enabled: true
      Length: 0.3
      Radius: 0.01
      Reference Frame: <Fixed Frame>
      Value: true

    # ---------- 1.1 filtro propio: naranja ----------
    - Class: rviz_default_plugins/Pose
      Name: 1.1 propio - pose
      Enabled: true
      Shape: Arrow
      Color: 255; 128; 25
      Alpha: 1
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.08
      Head Radius: 0.04
      Topic:
        Value: /imu_pose
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true

    - Class: rviz_default_plugins/Path
      Name: 1.1 propio - rastro
      Enabled: true
      Color: 255; 128; 25
      Alpha: 1
      Line Style: Lines
      Line Width: 0.03
      Buffer Length: 1
      Topic:
        Value: /imu_path
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true

    - Class: rviz_default_plugins/Marker
      Name: 1.1 propio - velocidad
      Enabled: true
      Topic:
        Value: /imu_vel_marker
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true

    # ---------- 1.2 DMP: celeste ----------
    - Class: rviz_default_plugins/Pose
      Name: 1.2 DMP - pose
      Enabled: true
      Shape: Arrow
      Color: 51; 178; 255
      Alpha: 1
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.08
      Head Radius: 0.04
      Topic:
        Value: /imu_pose_dmp
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true

    - Class: rviz_default_plugins/Path
      Name: 1.2 DMP - rastro
      Enabled: true
      Color: 51; 178; 255
      Alpha: 1
      Line Style: Lines
      Line Width: 0.03
      Buffer Length: 1
      Topic:
        Value: /imu_path_dmp
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true

    - Class: rviz_default_plugins/Marker
      Name: 1.2 DMP - velocidad
      Enabled: true
      Topic:
        Value: /imu_vel_marker_dmp
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 0.8
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 850
  Width: 1250
